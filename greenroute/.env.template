# ─────────────────────────────────────────────────────────────────────────────
# GreenRoute Intelligence Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
#   cp .env.template .env
#
# .env is gitignored.  .env.template is committed and safe — it has no secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ── Anthropic / Claude ────────────────────────────────────────────────────────
# Required. Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-

# Claude model used by all three agent nodes.
# Cheapest option that supports tool use:
CLAUDE_AGENT_MODEL=claude-haiku-4-5

# Token and temperature settings (defaults work for all corridors).
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.2


# ── Per-agent tool-call budgets (ReAct loop limits) ──────────────────────────
# Maritime / trucking SatelliteAnalyst uses up to 5 calls.
# Aviation SatelliteAnalyst uses up to 9 (handled via recursion_limit, not this).
SATELLITE_ANALYST_MAX_TOOL_CALLS=5
CORRIDOR_OPTIMIZER_MAX_TOOL_CALLS=5
CERTIFICATION_JUDGE_MAX_TOOL_CALLS=4


# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false


# ── Google Earth Engine (GEE) ─────────────────────────────────────────────────
# Only needed if you plan to re-generate the satellite grid JSON payloads.
# Not required to run the agents — they read pre-computed grid files.
#
# Service account email from your GCP project:
GEE_SERVICE_ACCOUNT=greenroute@your-gcp-project.iam.gserviceaccount.com
# Path to the downloaded JSON key file (relative to greenroute/ directory):
GEE_KEY_FILE=gee_service_account.json


# ── Firebase Realtime Database ────────────────────────────────────────────────
# Only needed for the synthesize node (Phase 4) to push GreenRouteDecision.
# Not required to run the first three agents.
#
# Your Firebase project's Realtime Database URL:
FIREBASE_URL=https://your-project-default-rtdb.firebaseio.com
# Path to the downloaded service account JSON key (relative to greenroute/):
FIREBASE_CREDENTIALS_FILE=firebase_service_account.json


# ── Default corridor / data paths ────────────────────────────────────────────
# Used as fallback when no corridor_id is passed to the API.
CORRIDOR_ID=SGP_PKL
GRID_FILE=data/maritime_grid_payload.json
BASELINES_FILE=data/baselines.json
